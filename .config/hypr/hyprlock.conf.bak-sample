general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    path = screenshot
    color = rgba(21, 18, 28, 1.0)
    blur_passes = 4
    blur_size = 7
    brightness = 0.5
    contrast = 0.9
    vibrancy = 0.15
    vibrancy_darkness = 0.2
}

# relógio, peso leve
label {
    monitor =
    text = $TIME
    color = rgba(236, 232, 244, 0.95)
    font_size = 96
    font_family = Iosevka Nerd Font Light
    position = 0, 150
    halign = center
    valign = center
}

# data
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d de %B" | sed 's/.*/\L&/'
    color = rgba(185, 163, 214, 0.9)
    font_size = 17
    font_family = Iosevka Nerd Font Light
    position = 0, 70
    halign = center
    valign = center
}

# linha fina decorativa
shape {
    monitor =
    size = 40, 1
    color = rgba(136, 119, 153, 0.7)
    rounding = 0
    position = 0, 30
    halign = center
    valign = center
}

# campo de senha fino
input-field {
    monitor =
    size = 280, 44
    outline_thickness = 1
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    dots_rounding = -1
    rounding = -1
    outer_color = rgba(136, 119, 153, 0.8)
    inner_color = rgba(21, 18, 28, 0.55)
    font_color = rgb(236, 232, 244)
    font_family = Iosevka Nerd Font Light
    check_color = rgb(185, 163, 214)
    fail_color = rgb(212, 112, 126)
    capslock_color = rgb(214, 196, 163)
    fade_on_empty = false
    hide_input = false
    placeholder_text = <span foreground="##a39aaf">󰌾  senha</span>
    fail_text = <span foreground="##d4707e">$FAIL</span>
    position = 0, -40
    halign = center
    valign = center
}

# usuário embaixo
label {
    monitor =
    text = $USER
    color = rgba(163, 154, 175, 0.8)
    font_size = 14
    font_family = Iosevka Nerd Font Light
    position = 0, -110
    halign = center
    valign = center
}

# música tocando (só aparece se houver player)
label {
    monitor =
    text = cmd[update:2000] playerctl metadata --format '󰎆  {{artist}} - {{title}}' 2>/dev/null
    color = rgba(163, 154, 175, 0.7)
    font_size = 13
    font_family = Iosevka Nerd Font Light
    position = 0, 40
    halign = center
    valign = bottom
}

# bateria no canto
label {
    monitor =
    text = cmd[update:30000] echo "󰁹  $(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)%"
    color = rgba(163, 154, 175, 0.7)
    font_size = 13
    font_family = Iosevka Nerd Font Light
    position = -24, 24
    halign = right
    valign = bottom
}
