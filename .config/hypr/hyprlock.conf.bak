# --- CORES (Paleta Catppuccin Mocha) ---
# Vermelho (Red): rgba(243, 139, 168, 1.0)
# Vermelho Escuro (Maroon): rgba(235, 160, 172, 1.0)
# Cinza Escuro (Caixa): rgba(30, 30, 46, 1.0)

background {
    monitor =
    path = screenshot   # Captura a tela atual
    
    # Efeitos de desfoque e escurecimento para manter a vibe "preto suave"
    blur_passes = 3     # Quantidade de vezes que o desfoque é aplicado
    blur_size = 8       # Intensidade do desfoque
    brightness = 0.4    # Escurece a tela capturada (0.0 a 1.0)
    noise = 0.015       # Adiciona um granulado leve estilo terminal retrô
    
    # Cor de fundo caso a screenshot falhe
    color = rgba(24, 24, 37, 1.0) 
}

input-field {
    monitor =
    size = 280, 50
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    
    outer_color = rgba(243, 139, 168, 1.0)
    inner_color = rgba(30, 30, 46, 0.8)
    font_color = rgba(243, 139, 168, 1.0)
    
    fade_on_empty = false
    placeholder_text = <i><span foreground="##f38ba8"> >_ insira a senha...</span></i>
    hide_input = false
    
    position = 0, -120
    halign = center
    valign = center
}

# --- RELÓGIO PRINCIPAL ---
label {
    monitor =
    text = $TIME
    color = rgba(243, 139, 168, 1.0)
    font_size = 90
    font_family = Iosevka Nerd Font
    
    position = 0, 80
    halign = center
    valign = center
}

# --- DATA ---
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A, %d de %B")"
    color = rgba(235, 160, 172, 1.0)
    font_size = 22
    font_family = Iosevka Nerd Font
    
    position = 0, -10
    halign = center
    valign = center
}

# --- MENSAGEM DE SAUDAÇÃO ---
label {
    monitor =
    text = SYSTEM LOCKED
    color = rgba(243, 139, 168, 0.8)
    font_size = 14
    font_family = Iosevka Nerd Font
    
    position = 0, 250
    halign = center
    valign = bottom
}
