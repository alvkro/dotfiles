{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-width": 460,
  "control-center-height": 760,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,

  "notification-window-width": 440,
  "notification-icon-size": 56,
  "notification-body-image-height": 140,
  "notification-body-image-width": 240,

  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "hide-on-action": true,
  "hide-on-clear": false,

  "widgets": [
    "title",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Central",
      "clear-all-button": true,
      "button-text": "󰎟  Limpar"
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 16
    },
    "volume": { "label": "󰕾" },
    "backlight": { "label": "󰃟" },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c '[[ $(bluetoothctl show | grep Powered | cut -d\" \" -f2) == \"yes\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂛",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw",
          "update-command": "sh -c '[[ $(swaync-client -D) == \"true\" ]] && echo true || echo false'"
        },
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp && hyprlock'"
        }
      ]
    }
  }
}
