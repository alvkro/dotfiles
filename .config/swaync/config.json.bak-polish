{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-width": 440,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,

  "notification-window-width": 440,
  "notification-icon-size": 56,
  "notification-body-image-height": 140,
  "notification-body-image-width": 240,

  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "hide-on-action": true,
  "hide-on-clear": false,

  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notificações",
      "clear-all-button": true,
      "button-text": "Limpar"
    },
    "dnd": {
      "text": "Não perturbe"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 14
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "actions": [
        { "label": "󰤨", "command": "kitty nmtui" },
        { "label": "󰂯", "command": "blueman-manager" },
        { "label": "󰌾", "command": "hyprlock" },
        { "label": "󰐥", "command": "nwg-bar" }
      ]
    }
  }
}
