@define-color bg        rgba(21, 18, 28, 0.92);
@define-color bg-card   rgba(36, 32, 46, 0.95);
@define-color bg-hover  #2d2b33;
@define-color fg        #cfc9d9;
@define-color fg-dim    #6b6575;
@define-color accent    #887799;
@define-color accent2   #b9a3d6;
@define-color urgent    #c0616f;

* {
  font-family: "Iosevka Nerd Font";
  font-size: 15px;
  transition: all 150ms ease;
}

/* ---------- NOTIFICAÇÕES (popups) ---------- */
.notification-row { outline: none; background: transparent; }

.notification-background {
  background: @bg;
  border: 2px solid alpha(@accent, 0.6);
  border-radius: 18px;
  margin: 8px 12px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
}
.notification-background:hover { border-color: @accent2; }
.notification-background.critical { border-color: @urgent; }

.notification { background: transparent; padding: 0; }
.notification-content { background: transparent; padding: 16px; }
.notification-default-action { background: transparent; border-radius: 18px; }
.notification-default-action:hover { background: alpha(@accent, 0.12); }

.image { margin-right: 14px; border-radius: 12px; }
.summary { color: @accent2; font-size: 17px; font-weight: bold; }
.time    { color: @fg-dim; font-size: 13px; }
.body    { color: @fg; font-size: 15px; }
.body-image { border-radius: 12px; margin-top: 8px; }

.close-button {
  background: @bg-card;
  color: @fg-dim;
  border: none;
  border-radius: 999px;
  min-width: 24px;
  min-height: 24px;
  margin: 10px;
  padding: 0;
}
.close-button:hover { background: @urgent; color: #15121c; }

.notification-action {
  background: @bg-card;
  color: @fg;
  border: none;
  border-radius: 12px;
  margin: 0 8px 10px 8px;
  padding: 8px;
}
.notification-action:hover { background: @accent; color: #15121c; }

/* ---------- CENTRO DE CONTROLE ---------- */
.control-center {
  background: @bg;
  border: 2px solid alpha(@accent, 0.6);
  border-radius: 22px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}
.control-center-list { background: transparent; }
.control-center .notification-background {
  background: @bg-card;
  border: 1px solid transparent;
  margin: 6px 10px;
  box-shadow: none;
}
.control-center .notification-background:hover { border-color: @accent; }

.widget-title {
  color: @accent2;
  font-size: 20px;
  font-weight: bold;
  margin: 16px 18px 6px 18px;
}
.widget-title > button {
  background: @bg-card;
  color: @fg;
  border: none;
  border-radius: 12px;
  padding: 6px 14px;
  font-size: 14px;
}
.widget-title > button:hover { background: @accent; color: #15121c; }

.widget-dnd {
  color: @fg;
  margin: 6px 18px 10px 18px;
}
.widget-dnd > switch {
  background: @bg-card;
  border: none;
  border-radius: 999px;
}
.widget-dnd > switch:checked { background: @accent; }
.widget-dnd > switch slider {
  background: @fg;
  border-radius: 999px;
}

/* ---------- PLAYER ---------- */
.widget-mpris {
  background: @bg-card;
  border-radius: 18px;
  margin: 6px 14px;
  padding: 10px;
}
.widget-mpris-player { background: transparent; padding: 6px; }
.widget-mpris-title    { color: @fg; font-size: 16px; font-weight: bold; }
.widget-mpris-subtitle { color: @fg-dim; font-size: 14px; }
.widget-mpris button {
  background: transparent;
  color: @accent2;
  border: none;
  border-radius: 12px;
}
.widget-mpris button:hover { background: @bg-hover; }

/* ---------- SLIDERS ---------- */
.widget-volume, .widget-backlight {
  background: @bg-card;
  border-radius: 16px;
  margin: 6px 14px;
  padding: 10px 16px;
  color: @accent2;
  font-size: 18px;
}
scale trough {
  background: @bg-hover;
  border-radius: 999px;
  min-height: 8px;
}
scale highlight {
  background: @accent;
  border-radius: 999px;
}
scale slider {
  background: @accent2;
  border-radius: 999px;
  min-width: 18px;
  min-height: 18px;
  margin: -6px;
  border: none;
}

/* ---------- GRADE DE BOTÕES ---------- */
.widget-buttons-grid {
  background: transparent;
  margin: 6px 14px 10px 14px;
  padding: 0;
}
.widget-buttons-grid > flowbox > flowboxchild > button {
  background: @bg-card;
  color: @accent2;
  border: none;
  border-radius: 16px;
  min-height: 52px;
  margin: 4px;
  font-size: 22px;
}
.widget-buttons-grid > flowbox > flowboxchild > button:hover {
  background: @accent;
  color: #15121c;
}
.widget-buttons-grid > flowbox > flowboxchild > button:checked {
  background: @accent;
  color: #15121c;
}
