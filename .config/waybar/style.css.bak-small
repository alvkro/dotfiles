* {
  font-family: "Iosevka Nerd Font";
  font-size: 14px;
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  transition: all 150ms ease;
}

/* a barra: caixa flutuante com borda fina */
window#waybar {
  background: rgba(26, 21, 35, 0.84);
  color: #cfc9d9;
  border: 1px solid rgba(168, 155, 191, 0.45);
  border-radius: 9px;
}

/* ---------- esquerda ---------- */
#custom-launcher {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 19px;
  color: #b8a9d0;
  padding: 0 14px 0 12px;
}
#custom-launcher:hover { color: #ece8f4; }

#workspaces { margin: 4px 0; }

#workspaces button {
  padding: 0 11px;
  margin: 0 2px;
  background: transparent;
  color: #4d4858;
  border-radius: 7px;
}
#workspaces button:not(.empty) { color: #8a829a; }
#workspaces button:hover {
  background: rgba(168, 155, 191, 0.14);
  color: #d5cfe0;
}
#workspaces button.active {
  background: rgba(168, 155, 191, 0.30);
  color: #ece8f4;
  font-weight: bold;
}
#workspaces button.urgent {
  background: rgba(201, 138, 150, 0.35);
  color: #ece8f4;
}

/* ---------- direita ---------- */
#mpris,
#cpu,
#memory,
#network,
#battery,
#custom-notification,
#clock,
#custom-power {
  background: transparent;
  color: #cfc9d9;
  padding: 0 11px;
}

#mpris.paused { color: #6b6575; }
#network.disconnected { color: #6b6575; }

#battery { color: #a89bbf; }
#battery.charging,
#battery.plugged { color: #a3c4a8; }
#battery.warning:not(.charging)  { color: #d6c4a3; }
#battery.critical:not(.charging) { color: #c98a96; }

#custom-notification {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 16px;
  color: #a89bbf;
}
#custom-notification.notification { color: #d0c3e6; }
#custom-notification.dnd-none,
#custom-notification.dnd-notification { color: #5d586a; }

#clock { padding: 0 12px; }

#custom-power {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 16px;
  color: #a89bbf;
  padding: 0 14px 0 8px;
}

#mpris:hover,
#cpu:hover,
#memory:hover,
#network:hover,
#custom-notification:hover,
#clock:hover { color: #ece8f4; }
#custom-power:hover { color: #c98a96; }

tooltip {
  background: #1a1523;
  border: 1px solid rgba(168, 155, 191, 0.4);
  border-radius: 8px;
}
tooltip label { color: #ece8f4; }

/* ---------- relógio central ---------- */
#clock.time {
  font-size: 20px;
  font-weight: bold;
  color: #cdb8ee;
  padding: 0 14px 0 4px;
}

#clock.date {
  font-size: 13px;
  color: #8a829a;
  padding: 0 4px 0 14px;
  margin: 9px 0;
  border-left: 1px solid rgba(168, 155, 191, 0.35);
}

#clock.time:hover { color: #ece8f4; }
#clock.date:hover { color: #cfc9d9; }
