* {
  font-family: "Iosevka Nerd Font";
  font-size: 12px;
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
}

window#waybar {
  background: rgba(21, 18, 28, 0.92);
  color: #cfc9d9;
  border-bottom: 1px solid rgba(157, 138, 181, 0.55);
}

/* ---------- workspaces ---------- */
#workspaces button {
  padding: 0 9px;
  color: #4a4655;
  background: transparent;
}
#workspaces button:not(.empty) { color: #a39aaf; }
#workspaces button:hover {
  background: rgba(157, 138, 181, 0.2);
  color: #ece8f4;
}
#workspaces button.active {
  background: #9d8ab5;
  color: #15121c;
  font-weight: bold;
}
#workspaces button.urgent {
  background: #d4707e;
  color: #15121c;
}

/* ---------- centro ---------- */
#clock {
  color: #ece8f4;
  padding: 0 12px;
}

/* ---------- direita ---------- */
#mpris,
#cpu,
#memory,
#network,
#custom-notification,
#custom-power {
  padding: 0 10px;
  color: #cfc9d9;
  border-left: 1px solid rgba(157, 138, 181, 0.25);
}

#mpris { color: #cdb8ee; border-left: none; }
#mpris.paused { color: #6b6575; }
#network.disconnected { color: #6b6575; }

#custom-notification {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 14px;
  color: #a39aaf;
}
#custom-notification.notification { color: #cdb8ee; }
#custom-notification.dnd-none,
#custom-notification.dnd-notification { color: #6b6575; }
#custom-notification:hover { color: #ffffff; }

#custom-power {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 14px;
  color: #9d8ab5;
}
#custom-power:hover {
  background: #d4707e;
  color: #15121c;
}

tooltip {
  background: #15121c;
  border: 1px solid rgba(157, 138, 181, 0.5);
  border-radius: 0;
}
tooltip label { color: #ece8f4; }
