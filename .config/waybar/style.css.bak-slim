* {
  font-family: "Iosevka Nerd Font";
  font-size: 15px;
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  transition: all 160ms ease;
}

window#waybar {
  background: transparent;
}

/* a barra inteira é um único container flutuante */
window#waybar > box {
  background: rgba(24, 20, 33, 0.86);
  border: 1px solid rgba(157, 138, 181, 0.35);
  border-radius: 18px;
  padding: 0 8px;
  color: #ece8f4;
}

/* ---------- workspaces ---------- */
#workspaces { margin: 5px 0; }

#workspaces button {
  padding: 0 11px;
  margin: 0 2px;
  color: #4a4655;
  background: transparent;
  border-radius: 12px;
}
#workspaces button:not(.empty) { color: #a39aaf; }
#workspaces button:hover {
  background: rgba(157, 138, 181, 0.18);
  color: #ece8f4;
}
#workspaces button.active {
  background: #9d8ab5;
  color: #15121c;
  font-weight: bold;
  padding: 0 16px;
}
#workspaces button.urgent {
  background: #d4707e;
  color: #15121c;
}

/* ---------- centro ---------- */
#clock {
  color: #ece8f4;
  font-size: 16px;
  padding: 0 14px;
}

/* ---------- direita ---------- */
#mpris,
#cpu,
#memory,
#network,
#custom-notification,
#custom-power {
  background: transparent;
  padding: 0 14px;
  color: #cfc9d9;
}

/* divisórias finas entre módulos */
#cpu,
#memory,
#network,
#custom-notification,
#custom-power {
  border-left: 1px solid rgba(157, 138, 181, 0.22);
  margin: 9px 0;
}

#mpris { color: #cdb8ee; }
#mpris.paused { color: #6b6575; }
#network.disconnected { color: #6b6575; }

#custom-notification {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 18px;
  color: #a39aaf;
}
#custom-notification.notification { color: #cdb8ee; }
#custom-notification.dnd-none,
#custom-notification.dnd-notification { color: #6b6575; }
#custom-notification:hover { color: #ffffff; }

#custom-power {
  font-family: "Iosevka Nerd Font Mono";
  font-size: 18px;
  color: #9d8ab5;
  padding-right: 12px;
}
#custom-power:hover { color: #d4707e; }

tooltip {
  background: #181421;
  border: 1px solid rgba(157, 138, 181, 0.5);
  border-radius: 12px;
}
tooltip label { color: #ece8f4; }
