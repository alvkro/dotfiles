* {
    bg:      #15121cee;
    bg-alt:  #2d2b33;
    fg:      #cfc9d9;
    fg-dim:  #6b6575;
    accent:  #887799;
    accent2: #b9a3d6;
    urgent:  #c0616f;

    background-color: transparent;
    text-color: @fg;
    font: "Iosevka Nerd Font 15";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    width: 700px;
}

mainbox { padding: 20px; spacing: 14px; }

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 14px 18px;
    spacing: 12px;
    children: [prompt, entry];
}
prompt { text-color: @accent2; }
entry  { placeholder: "buscar..."; placeholder-color: @fg-dim; }

listview { lines: 8; spacing: 6px; scrollbar: false; }

element { padding: 12px 16px; border-radius: 12px; spacing: 12px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @accent; text-color: #15121c; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 32px; }
