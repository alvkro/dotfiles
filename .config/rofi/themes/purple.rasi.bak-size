* {
    bg:      #15121cee;
    bg-alt:  #2d2b33;
    fg:      #cfc9d9;
    fg-dim:  #6b6575;
    accent:  #887799;
    accent2: #b9a3d6;
    urgent:  #c0616f;

    background-color: transparent;
    text-color: @fg;
    font: "Iosevka Nerd Font 12";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 0;
    width: 520px;
}

mainbox { padding: 12px; spacing: 8px; }

inputbar {
    background-color: @bg-alt;
    padding: 8px 12px;
    spacing: 8px;
    children: [prompt, entry];
}
prompt { text-color: @accent2; }
entry  { placeholder: "buscar..."; placeholder-color: @fg-dim; }

listview { lines: 8; spacing: 2px; scrollbar: false; }

element { padding: 8px 12px; border-radius: 0; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @accent; text-color: #15121c; }
element-text { text-color: inherit; }
element-icon { size: 20px; }
